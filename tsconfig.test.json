{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./dist-tests",
    "rootDir": "./",
    "strict": true,
    "sourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true
  },
  "include": [
    "tests/unit/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-tests"
  ]
}
